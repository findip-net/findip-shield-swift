{
  "about": "identify() inputs and the customer_context they must produce, before encryption. SHA-256 hex of (salt + \":\" + value) or of the value; emails trimmed and lower-cased; a value without a valid @ is not an email.",
  "cases": [
    {
      "name": "user id only",
      "input": {
        "userId": "42"
      },
      "expected": {
        "user_id_hash": "73475cb40a568e8da8a045ced110137e159f890ac4da883b6b17dc651b3a8049"
      }
    },
    {
      "name": "email is trimmed and lower-cased before hashing",
      "input": {
        "email": "  Jane.Doe@Example.COM "
      },
      "expected": {
        "email_domain": "example.com",
        "email_hash": "86e0b9e56c17cc4d12387e1949b85053fbe73bc3ce5a1188713a9d300cc6133d"
      }
    },
    {
      "name": "salt prefixes both values with a colon",
      "input": {
        "userId": 42,
        "email": "jane@example.com",
        "salt": "s3cret"
      },
      "expected": {
        "email_domain": "example.com",
        "user_id_hash": "3d895002371fa30b0c9a0b7371497fcbc8d44b20a35329bb2ff51111cf2de6b9",
        "email_hash": "cff98e7d91a6d0bbfd72490267596222cbc594eaaae4fd86a39761c2603ca432"
      }
    },
    {
      "name": "a value without an @ is not an email",
      "input": {
        "email": "not-an-email"
      },
      "expected": {}
    },
    {
      "name": "plan is sent as given",
      "input": {
        "userId": "u-1",
        "plan": "free"
      },
      "expected": {
        "plan": "free",
        "user_id_hash": "a24a7f55f278dd49fb1f99c5507800cb198a5bfe10fe2126cd0b25672152b0da"
      }
    }
  ]
}
