{
  "about": "Requests sent to POST /v1/shield/track for an app site registering the apps below, and what ingest must answer and store. No Origin header is sent. Cases with sdk_builds: true are exactly what a native SDK must build from the same inputs (event.timestamp aside); the others are ingest-only checks of things an SDK must never send. `browser` is the exact stored browser_json; `browser_absent` lists keys that must not be stored.",
  "site_apps": [
    {
      "platform": "ios",
      "bundleId": "com.example.app"
    },
    {
      "platform": "android",
      "bundleId": "com.example.app.android"
    }
  ],
  "cases": [
    {
      "name": "iOS login: device block stored under the browser key names, synthesised user agent, app recognition",
      "request": {
        "site_key": "pub_fixture00000000",
        "sdk": {
          "name": "findip-shield-ios",
          "version": "1.0.0",
          "integration": "ios"
        },
        "app": {
          "bundle_id": "com.example.app",
          "version": "4.2.1",
          "build": "1021"
        },
        "event": {
          "name": "login_attempt",
          "source": "manual"
        },
        "page": {
          "path": "/screen/login"
        },
        "session": {
          "session_id": "sess_AbCdEfGhIjKlMnOpQrStUv",
          "visitor_id": "vis_AbCdEfGhIjKlMnOpQrStUv",
          "storage": "app",
          "visitor_storage": "app"
        },
        "device": {
          "platform": "ios",
          "os_version": "18.1",
          "model_family": "iPhone",
          "locale": "en-GB",
          "timezone": "Europe/London",
          "screen": {
            "width": 393,
            "height": 852,
            "scale": 3
          },
          "signals": {
            "emulator": false,
            "rooted": null,
            "debugger": false
          }
        },
        "customer_context": {
          "email_hash": "86e0b9e56c17cc4d12387e1949b85053fbe73bc3ce5a1188713a9d300cc6133d",
          "email_domain": "example.com",
          "custom": {
            "method": "password"
          }
        },
        "privacy": {
          "mode": "balanced",
          "consent": {
            "granted": true,
            "source": "app"
          }
        }
      },
      "expected": {
        "status": 200,
        "integration": "ios",
        "event_name": "login_attempt",
        "page_path": "/screen/login",
        "browser": {
          "platform": "ios",
          "os_version": "18.1",
          "model_family": "iPhone",
          "language": "en-GB",
          "timezone": "Europe/London",
          "screen": {
            "width": 393,
            "height": 852,
            "scale": 3
          },
          "signals": {
            "emulator": false,
            "rooted": null,
            "debugger": false
          },
          "app_id": "com.example.app",
          "app_version": "4.2.1",
          "app_build": "1021",
          "user_agent": "findip-shield-ios/1.0.0 (iOS 18.1; iPhone) com.example.app/4.2.1",
          "recognition": {
            "session": "app",
            "visitor": "app"
          }
        }
      },
      "sdk_builds": true
    },
